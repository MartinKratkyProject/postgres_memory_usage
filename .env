AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Metrics DB connection (internal Postgres used by Airflow and for storing measurements)
METRICS_PG_USER=airflow
METRICS_PG_PASSWORD=airflow
METRICS_PG_HOST=postgres
METRICS_PG_PORT=5432
METRICS_PG_DB=airflow
METRICS_PG_CONN_ID=metrics_pg_conn


# Target PG connection (external DB to be monitored)
TARGET_PG_USER=client_user
TARGET_PG_PASSWORD=client_pass
TARGET_PG_HOST=some-hostname-or-ip
TARGET_PG_PORT=5432
TARGET_PG_DB=clientdb
TARGET_PG_CONN_ID=target_pg_conn

# Monitoring configuration
MONITOR_SCHEMA=public
# MONITOR_TABLES_JSON=["table1", "table2"]  # optional; omit or use [] to check all tables
MONITOR_TABLES_JSON=[]